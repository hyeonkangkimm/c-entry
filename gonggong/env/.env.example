# Copy this file to env/local.env and fill in local secrets.
# Do not commit env/local.env.

DB_URL=jdbc:postgresql://localhost:5432/gonggong
DB_USER=gonggong
DB_PASSWORD=gonggong

SAFETY_KOREA_API_KEY=
CUSTOMS_API_KEY=
CHEMICAL_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

HSK_EMBEDDING_INITIALIZE=true
HSK_EMBEDDING_BATCH_SIZE=100

SAFETY_KOREA_API_URL=https://www.safetykorea.kr/release/openapi
SAFETY_KOREA_CERTIFICATION_LIST_URL=https://www.safetykorea.kr/openapi/api/cert/certificationList.json
OPENAI_RESPONSES_API_URL=https://api.openai.com/v1/responses
UNIPASS_URL=https://unipass.customs.go.kr/
PRODUCT_SAFETY_CENTER_URL=https://www.safetykorea.kr/

# Customs confirmation target goods API
CUSTOMS_CONFIRMATION_API_URL=
CUSTOMS_CONFIRMATION_SERVICE_KEY=
CUSTOMS_CONFIRMATION_SERVICE_KEY_PARAM=serviceKey
CUSTOMS_CONFIRMATION_HSK_CODE_PARAM=hsSgn
CUSTOMS_CONFIRMATION_IMPORT_EXPORT_CODE_PARAM=imexTpcd
CUSTOMS_CONFIRMATION_IMPORT_CODE=2
